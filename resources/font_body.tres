[gd_resource type="SystemFont" format=3]

; The game's body font. A SystemFont picks the first family the machine
; actually has, so this needs no font file in the repo and degrades to the
; engine default if none of them are present.
;
; Trebuchet MS is the pick: humanist and slightly playful (the flared M, the
; curled descenders) without tipping into novelty, and it stays readable at the
; small sizes the backbox status line uses. Candara and Segoe UI back it up.
;
; TO BUNDLE A REAL FONT INSTEAD: drop a .ttf in assets/fonts/ and point
; gui/theme/custom_font in project.godot at it. That is the export-safe option -
; a system font is only guaranteed on machines that happen to have it.

[resource]
font_names = PackedStringArray("Trebuchet MS", "Candara", "Segoe UI", "DejaVu Sans")
font_weight = 400
antialiasing = 1
subpixel_positioning = 1
